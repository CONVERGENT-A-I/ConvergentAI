// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Falls back to dummy URL if DATABASE_URL is not set (for builds)
  // Runtime checks in database.ts prevent actual connections to dummy URL
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE MODELS
// ============================================================================

model User {
  id String @id @default(uuid())

  // Identity
  email         String  @unique
  phone         String?
  legalName     String? @map("legal_name")
  preferredName String? @map("preferred_name")

  // Authentication (for future)
  passwordHash  String? @map("password_hash")
  emailVerified Boolean @default(false) @map("email_verified")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  // Soft Delete
  deletedAt DateTime? @map("deleted_at")

  // Metadata
  ipAddress      String? @map("ip_address")
  userAgent      String? @map("user_agent")
  referralSource String? @map("referral_source")

  // Relations
  applications    Application[]
  sessions        Session[]
  whitepaperLeads WhitepaperLead[]

  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Application {
  id     String @id @default(uuid())
  userId String @map("user_id")

  // Session Link
  livekitRoomName String? @map("livekit_room_name")
  sessionId       String? @map("session_id")

  // Application Status
  status       ApplicationStatus @default(DRAFT)
  currentStage String            @default("1") @map("current_stage")

  // Metadata
  fieldAttempts Json @default("{}") @map("field_attempts")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  submittedAt DateTime? @map("submitted_at")
  completedAt DateTime? @map("completed_at")

  // Soft Delete
  deletedAt DateTime? @map("deleted_at")

  // Metadata
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  notes     String?

  // Relations
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage1           Stage1Discovery?
  stage2           Stage2PreQualification?
  stage3           Stage3Application?
  stage4           Stage4Underwriting?
  conversations    Conversation[]
  sessions         Session[]
  consents         Consent[]
  stageTransitions StageTransition[]
  metrics          Metric[]
  errorLogs        ErrorLog[]

  @@index([userId])
  @@index([status])
  @@index([currentStage])
  @@index([createdAt])
  @@index([livekitRoomName])
  @@index([sessionId])
  @@index([userId, status])
  @@map("applications")
}

enum ApplicationStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  APPROVED
  APPROVED_WITH_CONDITIONS
  REFERRED
  SUSPENDED
  DECLINED
  WITHDRAWN

  @@map("application_status")
}

// ============================================================================
// STAGE MODELS
// ============================================================================

model Stage1Discovery {
  id            String @id @default(uuid())
  applicationId String @unique @map("application_id")

  borrowerName          String? @map("borrower_name")
  borrowerNameConfirmed Boolean @default(false) @map("borrower_name_confirmed")

  mortgageGoal          String? @map("mortgage_goal")
  mortgageGoalConfirmed Boolean @default(false) @map("mortgage_goal_confirmed")

  occupancy          String?
  occupancyConfirmed Boolean @default(false) @map("occupancy_confirmed")

  existingRelationship          String? @map("existing_relationship")
  existingRelationshipConfirmed Boolean @default(false) @map("existing_relationship_confirmed")

  timeline          String?
  timelineConfirmed Boolean @default(false) @map("timeline_confirmed")

  coBorrower          String? @map("co_borrower")
  coBorrowerConfirmed Boolean @default(false) @map("co_borrower_confirmed")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("stage1_discovery")
}

model Stage2PreQualification {
  id            String @id @default(uuid())
  applicationId String @unique @map("application_id")

  grossAnnualIncome          Decimal? @map("gross_annual_income") @db.Decimal(12, 2)
  grossAnnualIncomeConfirmed Boolean  @default(false) @map("gross_annual_income_confirmed")

  monthlyDebt          Decimal? @map("monthly_debt") @db.Decimal(10, 2)
  monthlyDebtConfirmed Boolean  @default(false) @map("monthly_debt_confirmed")

  creditRange          String? @map("credit_range")
  creditRangeConfirmed Boolean @default(false) @map("credit_range_confirmed")

  downPayment          Decimal? @map("down_payment") @db.Decimal(12, 2)
  downPaymentConfirmed Boolean  @default(false) @map("down_payment_confirmed")

  targetPrice          Decimal? @map("target_price") @db.Decimal(12, 2)
  targetPriceConfirmed Boolean  @default(false) @map("target_price_confirmed")

  rentOwn          String? @map("rent_own")
  rentOwnConfirmed Boolean @default(false) @map("rent_own_confirmed")

  realtorStatus          String? @map("realtor_status")
  realtorStatusConfirmed Boolean @default(false) @map("realtor_status_confirmed")

  refinanceType          String? @map("refinance_type")
  refinanceTypeConfirmed Boolean @default(false) @map("refinance_type_confirmed")

  propertyType          String? @map("property_type")
  propertyTypeConfirmed Boolean @default(false) @map("property_type_confirmed")

  militaryRural          String? @map("military_rural")
  militaryRuralConfirmed Boolean @default(false) @map("military_rural_confirmed")

  jobTenureType          String? @map("job_tenure_type")
  jobTenureTypeConfirmed Boolean @default(false) @map("job_tenure_type_confirmed")

  pendingConfirmField String? @map("pending_confirm_field")
  pendingConfirmValue String? @map("pending_confirm_value")

  bridgeToSay String? @map("bridge_to_say")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("stage2_pre_qualification")
}

model Stage3Application {
  id            String @id @default(uuid())
  applicationId String @unique @map("application_id")

  // Stage 3: Product Guidance
  eligibleProducts Json @default("[]") @map("eligible_products")

  programComparisonInterest          String? @map("program_comparison_interest")
  programComparisonInterestConfirmed Boolean @default(false) @map("program_comparison_interest_confirmed")

  financialPriority          String? @map("financial_priority")
  financialPriorityConfirmed Boolean @default(false) @map("financial_priority_confirmed")

  homeHorizon          String? @map("home_horizon")
  homeHorizonConfirmed Boolean @default(false) @map("home_horizon_confirmed")

  // Stage 3A: Consent & Identity
  legalName          String? @map("legal_name")
  legalNameConfirmed Boolean @default(false) @map("legal_name_confirmed")

  physicalAddress          String? @map("physical_address")
  physicalAddressConfirmed Boolean @default(false) @map("physical_address_confirmed")

  softPullConsent          String?   @map("soft_pull_consent")
  softPullConsentTimestamp DateTime? @map("soft_pull_consent_timestamp")

  employer String?

  prefilledFieldsConfirmed Json @default("{}") @map("prefilled_fields_confirmed")

  // Stage 3B: Application Completion
  maritalStatus          String? @map("marital_status")
  maritalStatusConfirmed Boolean @default(false) @map("marital_status_confirmed")

  dependents          Int?    @default(0)
  dependentsConfirmed Boolean @default(false) @map("dependents_confirmed")

  employmentPosition  String?  @map("employment_position")
  employmentYears     Decimal? @map("employment_years") @db.Decimal(4, 1)
  selfEmployed        Boolean? @map("self_employed")
  employmentConfirmed Boolean  @default(false) @map("employment_confirmed")

  checkingSavingsBalance   Decimal? @map("checking_savings_balance") @db.Decimal(12, 2)
  checkingSavingsConfirmed Boolean  @default(false) @map("checking_savings_confirmed")

  declarationsBankruptcy  Boolean? @map("declarations_bankruptcy")
  declarationsForeclosure Boolean? @map("declarations_foreclosure")
  declarationsConfirmed   Boolean  @default(false) @map("declarations_confirmed")

  readyToSubmit Boolean @default(false) @map("ready_to_submit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("stage3_application")
}

model Stage4Underwriting {
  id            String @id @default(uuid())
  applicationId String @unique @map("application_id")

  ausStatus          String?   @map("aus_status")
  ausResultTimestamp DateTime? @map("aus_result_timestamp")
  ausConfirmed       Boolean   @default(false) @map("aus_confirmed")

  checklistDiscussed Boolean @default(false) @map("checklist_discussed")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("stage4_underwriting")
}

// ============================================================================
// CONVERSATION & SESSION MODELS
// ============================================================================

model Conversation {
  id            String @id @default(uuid())
  applicationId String @map("application_id")

  role MessageRole
  text String      @db.Text

  turnNumber Int      @map("turn_number")
  timestamp  DateTime @default(now())

  audioUrl String? @map("audio_url")
  duration Int?

  lowConfidence  Boolean @default(false) @map("low_confidence")
  wasInterrupted Boolean @default(false) @map("was_interrupted")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, turnNumber])
  @@index([timestamp])
  @@index([role])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM

  @@map("message_role")
}

model Session {
  id            String  @id @default(uuid())
  userId        String  @map("user_id")
  applicationId String? @map("application_id")

  livekitRoomName String  @map("livekit_room_name")
  livekitToken    String? @map("livekit_token") @db.Text
  participantName String  @map("participant_name")

  status SessionStatus @default(ACTIVE)

  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")
  durationMs Int?      @map("duration_ms")

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  totalTurns   Int     @default(0) @map("total_turns")
  stageReached String? @map("stage_reached")

  compactionCount Int @default(0) @map("compaction_count")
  rotationCount   Int @default(0) @map("rotation_count")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@index([livekitRoomName])
  @@index([status])
  @@index([startedAt])
  @@map("sessions")
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  ERROR
  TIMEOUT

  @@map("session_status")
}

// ============================================================================
// COMPLIANCE & AUDIT MODELS
// ============================================================================

model Consent {
  id            String @id @default(uuid())
  applicationId String @map("application_id")

  consentType    ConsentType   @map("consent_type")
  status         ConsentStatus @default(PENDING)
  disclosureText String        @map("disclosure_text") @db.Text

  presentedAt DateTime  @default(now()) @map("presented_at")
  respondedAt DateTime? @map("responded_at")

  ipAddress String  @map("ip_address")
  userAgent String? @map("user_agent")

  metadata Json @default("{}")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([consentType])
  @@index([status])
  @@index([presentedAt])
  @@map("consents")
}

enum ConsentType {
  SOFT_PULL_CREDIT
  STAGE2_CLOSING_OFFER
  STAGE3B_SUBMISSION
  PREFILL_CONFIRMATION
  TERMS_OF_SERVICE
  PRIVACY_POLICY

  @@map("consent_type")
}

enum ConsentStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN

  @@map("consent_status")
}

model WhitepaperLead {
  id     String  @id @default(uuid())
  userId String? @map("user_id")

  name         String
  title        String
  organization String
  email        String
  phone        String?

  submittedAt DateTime @default(now()) @map("submitted_at")

  syncedToSheets Boolean   @default(false) @map("synced_to_sheets")
  syncedAt       DateTime? @map("synced_at")
  syncError      String?   @map("sync_error")

  ipAddress      String? @map("ip_address")
  userAgent      String? @map("user_agent")
  referralSource String? @map("referral_source")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([submittedAt])
  @@index([syncedToSheets])
  @@map("whitepaper_leads")
}

model StageTransition {
  id            String @id @default(uuid())
  applicationId String @map("application_id")

  fromStage String @map("from_stage")
  toStage   String @map("to_stage")

  transitionedAt DateTime @default(now()) @map("transitioned_at")
  durationMs     Int?     @map("duration_ms")

  turnNumber  Int     @map("turn_number")
  triggeredBy String? @map("triggered_by")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, transitionedAt])
  @@index([toStage])
  @@map("stage_transitions")
}

// ============================================================================
// METRICS & MONITORING MODELS
// ============================================================================

model Metric {
  id            String  @id @default(uuid())
  applicationId String? @map("application_id")
  sessionId     String? @map("session_id")

  turnNumber   Int @map("turn_number")
  sessionAgeMs Int @map("session_age_ms")

  contextItemCount       Int @map("context_item_count")
  estimatedContextTokens Int @map("estimated_context_tokens")

  sttLatencyMs   Int? @map("stt_latency_ms")
  llmTtftMs      Int? @map("llm_ttft_ms")
  llmTotalMs     Int? @map("llm_total_ms")
  ttsLatencyMs   Int? @map("tts_latency_ms")
  avatarRenderMs Int? @map("avatar_render_ms")
  e2eLatencyMs   Int? @map("e2e_latency_ms")

  sttStartAt         DateTime? @map("stt_start_at")
  sttCompleteAt      DateTime? @map("stt_complete_at")
  llmStartAt         DateTime? @map("llm_start_at")
  llmFirstTokenAt    DateTime? @map("llm_first_token_at")
  llmCompleteAt      DateTime? @map("llm_complete_at")
  ttsStartAt         DateTime? @map("tts_start_at")
  ttsCompleteAt      DateTime? @map("tts_complete_at")
  avatarFirstFrameAt DateTime? @map("avatar_first_frame_at")

  compactionRan Boolean @default(false) @map("compaction_ran")
  rotationRan   Boolean @default(false) @map("rotation_ran")

  recordedAt DateTime @default(now()) @map("recorded_at")

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([sessionId])
  @@index([turnNumber])
  @@index([recordedAt])
  @@index([e2eLatencyMs])
  @@map("metrics")
}

model ErrorLog {
  id            String  @id @default(uuid())
  applicationId String? @map("application_id")
  sessionId     String? @map("session_id")

  errorType  ErrorType     @map("error_type")
  severity   ErrorSeverity
  message    String        @db.Text
  stackTrace String?       @map("stack_trace") @db.Text

  turnNumber   Int?    @map("turn_number")
  stage        String?
  pendingField String? @map("pending_field")

  metadata Json @default("{}")

  occurredAt DateTime @default(now()) @map("occurred_at")

  resolved   Boolean   @default(false)
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by")
  resolution String?   @db.Text

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([sessionId])
  @@index([errorType])
  @@index([severity])
  @@index([occurredAt])
  @@index([resolved])
  @@map("error_logs")
}

enum ErrorType {
  API_FAILURE_CEREBRAS
  API_FAILURE_CARTESIA
  API_FAILURE_LIVEKIT
  API_FAILURE_LEMONSLICE
  EXTRACTION_FAILURE
  LOW_CONFIDENCE_STT
  CONTEXT_COMPACTION_FAILURE
  TIMEOUT
  VALIDATION_ERROR
  UNKNOWN

  @@map("error_type")
}

enum ErrorSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL

  @@map("error_severity")
}

model ContextEvent {
  id        String @id @default(uuid())
  sessionId String @map("session_id")

  eventType ContextEventType @map("event_type")

  itemsBefore  Int  @map("items_before")
  itemsAfter   Int  @map("items_after")
  tokensBefore Int? @map("tokens_before")
  tokensAfter  Int? @map("tokens_after")

  summary String? @db.Text
  reason  String?

  occurredAt DateTime @default(now()) @map("occurred_at")
  durationMs Int?     @map("duration_ms")

  @@index([sessionId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("context_events")
}

enum ContextEventType {
  COMPACTION
  ROTATION
  EXTRACTION_START
  EXTRACTION_COMPLETE

  @@map("context_event_type")
}

// ============================================================================
// PRODUCT & ANALYTICS MODELS (TIER 4)
// ============================================================================

model LoanProduct {
  id String @id @default(uuid())

  name        String
  productCode String          @unique @map("product_code")
  category    ProductCategory

  termMonths Int     @map("term_months")
  isFixed    Boolean @map("is_fixed")

  minCreditScore Int     @map("min_credit_score")
  maxLtv         Decimal @map("max_ltv") @db.Decimal(5, 2)
  minDownPayment Decimal @map("min_down_payment") @db.Decimal(5, 2)

  requiresPmi      Boolean @default(false) @map("requires_pmi")
  allowsInvestment Boolean @default(false) @map("allows_investment")

  description String @db.Text

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rates LoanRate[]

  @@index([category])
  @@index([active])
  @@map("loan_products")
}

enum ProductCategory {
  CONVENTIONAL
  FHA
  VA
  USDA
  JUMBO

  @@map("product_category")
}

model LoanRate {
  id        String @id @default(uuid())
  productId String @map("product_id")

  baseRate Decimal @map("base_rate") @db.Decimal(5, 3)
  apr      Decimal @db.Decimal(5, 3)

  minCreditScore Int @map("min_credit_score")
  maxCreditScore Int @map("max_credit_score")

  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  product LoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([effectiveFrom, effectiveTo])
  @@map("loan_rates")
}

model Escalation {
  id            String @id @default(uuid())
  applicationId String @map("application_id")

  reason        String
  reasonDetails String? @map("reason_details") @db.Text

  escalatedAt DateTime  @default(now()) @map("escalated_at")
  assignedTo  String?   @map("assigned_to")
  resolvedAt  DateTime? @map("resolved_at")

  outcome String?
  notes   String? @db.Text

  @@index([applicationId])
  @@index([escalatedAt])
  @@index([assignedTo])
  @@map("escalations")
}
